# Learning by Doing – optionale KI-Konfiguration
# Diese Datei darf ins Repository. Echte Schlüssel gehören ausschließlich in .env.

# Lokale KI (Standard, kostenlos)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Optional: OpenAI. Leer lassen, wenn du ausschließlich Ollama verwenden möchtest.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Maximale Wartezeit auf eine KI-Antwort in Sekunden
AI_TIMEOUT=180
